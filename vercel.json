{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "echo 'API-only deployment: the site itself is on GitHub Pages.'",
  "outputDirectory": "vercel-static",
  "rewrites": [{ "source": "/api/:path*", "destination": "/api" }],
  "functions": { "api/index.ts": { "maxDuration": 30 } }
}
